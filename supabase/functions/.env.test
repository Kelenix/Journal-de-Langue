# Configuration des tests d'intégration (`flutter test test_integration`) : aucun secret.
# Les appels à Claude sont dirigés vers un faux serveur lancé par les tests eux-mêmes.
# Usage : supabase functions serve --env-file supabase/functions/.env.test
ANTHROPIC_API_KEY=cle-de-test-sans-valeur
ANTHROPIC_BASE_URL=http://host.docker.internal:55399

# Secret partagé du webhook d'achats, utilisé par les tests d'intégration.
REVENUECAT_WEBHOOK_AUTHORIZATION=secret-de-test-du-webhook

# Clés de vérification des rappels AdMob servies par le faux serveur (aucune clé).
ADMOB_VERIFIER_KEYS_URL=http://host.docker.internal:55399/admob-keys
