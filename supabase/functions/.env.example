# Secrets des Edge Functions en local. Copier vers `supabase/functions/.env` (ignoré par Git)
# puis redémarrer Supabase. En production : `supabase secrets set NOM=valeur`.

# Clé API Anthropic (console.anthropic.com). Ne jamais la commiter ni la coller dans un chat.
ANTHROPIC_API_KEY=

# Facultatif : modèle utilisé pour la correction de base (défaut : claude-haiku-5-5).
# CORRECTION_MODEL=claude-haiku-5-5
# Facultatif : modèle des corrections avancées Premium (défaut : claude-sonnet-5-5),
# des reformulations et des exercices (défaut : claude-haiku-5-5).
# ADVANCED_CORRECTION_MODEL=claude-sonnet-5-5
# REWRITE_MODEL=claude-haiku-5-5
# EXERCISE_MODEL=claude-haiku-5-5
# Facultatif : modèle des simulations d'examen (défaut : claude-sonnet-5-5).
# EXAM_MODEL=claude-sonnet-5-5

# Secret partagé avec RevenueCat : une longue chaîne aléatoire, à saisir aussi dans
# RevenueCat (Integrations > Webhooks > Authorization header).
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Identifiants numériques des blocs de vidéos récompensées AdMob de l'app, séparés par des
# virgules : seuls leurs rappels accordent une récompense (fonction admob-reward).
ADMOB_REWARDED_AD_UNITS=
