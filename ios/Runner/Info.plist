	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- Seul le chiffrement standard du système est utilisé (HTTPS, trousseau) :
	     exempté de déclaration d'exportation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Le micro sert uniquement à dicter ton journal.</string>
